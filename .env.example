# Core runtime
APP_ENV=development
TZ=UTC

# PostgreSQL
POSTGRES_DB=trading_analyst
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading_analyst

# Frontend API target
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# External provider keys (optional in Phase 1)
ALPHAVANTAGE_API_KEY=
CCXT_EXCHANGE_ID=binance
MARKET_DATA_CACHE_TTL_SECONDS=30
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_RETRY_BACKOFF_SECONDS=0.3
NEWS_CACHE_TTL_SECONDS=120
NEWS_RETRY_ATTEMPTS=3
NEWS_RETRY_BACKOFF_SECONDS=0.4
